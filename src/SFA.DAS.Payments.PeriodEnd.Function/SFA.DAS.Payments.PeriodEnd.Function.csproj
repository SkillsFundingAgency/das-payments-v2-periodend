<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	  <TargetFramework>net8.0</TargetFramework>
	  <AzureFunctionsVersion>v4</AzureFunctionsVersion>
	  <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
	  <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="8.0.0" />
	  <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
	  <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
	  <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
	  <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
	  <PackageReference Include="SFA.DAS.Payments.Application" Version="2.2.2" />
	  <PackageReference Include="SFA.DAS.Payments.DataLocks.Messages" Version="0.2.3" />
	  <PackageReference Include="SFA.DAS.Payments.Messages.Common" Version="2.2.2" />
	  <PackageReference Include="SFA.DAS.Payments.Messaging" Version="2.2.2" />
	  <PackageReference Include="SFA.DAS.Payments.Model.Core" Version="2.2.2" />
	  <PackageReference Include="SFA.DAS.Payments.Monitoring.Jobs.Client" Version="2.1.5-prerelease-2" />
	  <PackageReference Include="SFA.DAS.Payments.Monitoring.Jobs.Data" Version="0.5.8" />
	  <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.34.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SFA.DAS.Payments.PeriodEnd.Application\SFA.DAS.Payments.PeriodEnd.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="local.settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
